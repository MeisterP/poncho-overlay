From: Sergey Malinin <sergmalinin@gmail.com>
Date: Mon, 17 Aug 2026 01:10:40 +0300
Subject: [PATCH] Fix: fit MTP/NextN layer accounting in n_gpu_layers

---
 common/fit.cpp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/common/fit.cpp b/common/fit.cpp
index dd1f3ef76619..c82d066ad444 100644
--- a/common/fit.cpp
+++ b/common/fit.cpp
@@ -136,10 +136,7 @@ static std::vector<llama_device_memory_data> common_get_device_memory_data_impl(
         devs.push_back(llama_model_get_device(model, i));
     }
 
-    hp_ngl         = llama_model_n_layer(model);
-    if (mparams->load_mtp) {
-        hp_ngl    += llama_model_n_layer_nextn(model);
-    }
+    hp_ngl         = llama_model_n_layer(model) + llama_model_n_layer_nextn(model);
     hp_n_ctx_train = llama_model_n_ctx_train(model);
     hp_n_expert    = llama_model_n_expert(model);
 
