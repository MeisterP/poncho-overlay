From 9dbd0be68597d4433943d0160e20cdf0d755bbf8 Mon Sep 17 00:00:00 2001
From: Sergey Malinin <sergmalinin@gmail.com>
Date: Tue, 29 Sep 2026 17:11:27 +0200
Subject: [PATCH 2/2] fit : count NextN layers in the n_gpu_layers bound even
 when MTP is off

hp_ngl caps n_gpu_layers (hp_ngl + 1) and starts the fitter's
back-to-front assignment, so it must cover all assignable layers,
not only the offloaded ones. Since 9a688e51e, NextN layers were
excluded when load_mtp was false, which lowered the ceiling for the
regular layers too: common_fit then left layer 0 on CPU for models
whose layers all fit in VRAM (e.g. Qwen3.6-35B-MoE, ~28% slower pp).

See https://github.com/ggml-org/llama.cpp/issues/27171
---
 common/fit.cpp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/common/fit.cpp b/common/fit.cpp
index 7a0300829..77707ecf9 100644
--- a/common/fit.cpp
+++ b/common/fit.cpp
@@ -137,10 +137,7 @@ static std::vector<llama_device_memory_data> common_get_device_memory_data_impl(
         devs.push_back(llama_model_get_device(model, i));
     }
 
-    hp_ngl         = llama_model_n_layer(model);
-    if (mparams->load_mtp) {
-        hp_ngl    += llama_model_n_layer_nextn(model);
-    }
+    hp_ngl         = llama_model_n_layer(model) + llama_model_n_layer_nextn(model);
     hp_n_ctx_train = llama_model_n_ctx_train(model);
     hp_n_expert    = llama_model_n_expert(model);
 
