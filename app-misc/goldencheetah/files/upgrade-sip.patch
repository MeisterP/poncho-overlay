+
+    if (PyArg_ParseTuple(args, "O!:transferback", &sipWrapper_Type, &w))
+    {
+        sip_api_transfer_back(w);
+
+        Py_INCREF(Py_None);
+        return Py_None;
+    }
+
+    return NULL;
+}
