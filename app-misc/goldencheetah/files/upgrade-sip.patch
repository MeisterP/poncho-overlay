+/*
+ * Display a printf() style message to stderr according to the current trace
+ * mask.
+ */
+static void sip_api_trace(unsigned mask, const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap,fmt);
+
+    if (mask & traceMask)
+        vfprintf(stderr, fmt, ap);
+
+    va_end(ap);
+}
