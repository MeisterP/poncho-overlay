+/*
+ * Parse an encoded string and return it and a new reference to the object that
+ * owns the string.
+ */
+static PyObject *parseString_AsEncodedString(PyObject *bytes, PyObject *obj,
+        const char **ap)
+{
+    if (bytes != NULL)
+    {
+        *ap = PyBytes_AS_STRING(bytes);
