+/*
+ * Mark an instance as having been deleted.
+ */
+static PyObject *setDeleted(PyObject *self, PyObject *args)
+{
+    sipSimpleWrapper *sw;
+
+    (void)self;
+
+    if (!PyArg_ParseTuple(args, "O!:setdeleted", &sipSimpleWrapper_Type, &sw))
+        return NULL;
+
+    clear_wrapper(sw);
+
+    Py_INCREF(Py_None);
+    return Py_None;
+}
