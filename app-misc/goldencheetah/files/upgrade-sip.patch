+/*
+ * Add the given Python object to the given list.  Return 0 if there was no
+ * error.
+ */
+static int addPyObjectToList(sipPyObject **head, PyObject *object)
+{
+    sipPyObject *po;
+
+    if ((po = sip_api_malloc(sizeof (sipPyObject))) == NULL)
+        return -1;
+
+    po->object = object;
+    po->next = *head;
+
+    *head = po;
+
+    return 0;
+}
