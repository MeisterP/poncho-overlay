+/*
+ * Parse a character string and return it.
+ */
+static int parseBytes_AsString(PyObject *obj, const char **ap)
+{
+    const char *a;
+    Py_ssize_t sz;
+
+    if (parseBytes_AsCharArray(obj, &a, &sz) < 0)
+        return -1;
+
+    if (ap != NULL)
+        *ap = a;
+
+    return 0;
+}
