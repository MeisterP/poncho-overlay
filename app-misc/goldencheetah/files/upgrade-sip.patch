diff --git a/appveyor/macos/after_build.sh b/appveyor/macos/after_build.sh
index 8696e7be6f..9887432e64 100755
--- a/appveyor/macos/after_build.sh
+++ b/appveyor/macos/after_build.sh
@@ -2,27 +2,99 @@
