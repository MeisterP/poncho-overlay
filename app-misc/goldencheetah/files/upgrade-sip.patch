+static PyObject *setTraceMask(PyObject *self, PyObject *args)
+{
+    unsigned new_mask;
+
+    (void)self;
+
+    if (PyArg_ParseTuple(args, "I:settracemask", &new_mask))
+    {
+        traceMask = new_mask;
+
+        Py_INCREF(Py_None);
+        return Py_None;
+    }
+
+    return NULL;
+}
