+
+/*
+ * The metatype setattro slot.
+ */
+static int sipWrapperType_setattro(PyObject *self, PyObject *name,
+        PyObject *value)
+{
+    if (sip_add_all_lazy_attrs(((sipWrapperType *)self)->wt_td) < 0)
+        return -1;
+
+    return PyType_Type.tp_setattro(self, name, value);
+}
