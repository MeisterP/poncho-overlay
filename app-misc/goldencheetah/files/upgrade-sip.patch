+/*
+ * The metatype getattro slot.
+ */
+static PyObject *sipWrapperType_getattro(PyObject *self, PyObject *name)
+{
+    if (sip_add_all_lazy_attrs(((sipWrapperType *)self)->wt_td) < 0)
+        return NULL;
+
+    return PyType_Type.tp_getattro(self, name);
+}
