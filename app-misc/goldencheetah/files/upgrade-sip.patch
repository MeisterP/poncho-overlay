+/*
+ * Set a dictionary item and discard the reference to the item even if there
+ * was an error.
+ */
+int sip_dict_set_and_discard(PyObject *dict, const char *name, PyObject *obj)
+{
+    int rc;
+
+    if (obj == NULL)
+        return -1;
+
+    rc = PyDict_SetItemString(dict, name, obj);
+
+    Py_DECREF(obj);
+
+    return rc;
+}
