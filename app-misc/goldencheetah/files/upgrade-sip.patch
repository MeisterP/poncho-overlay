+/*
+ * This is called by the atexit module.
+ */
+static PyObject *sip_exit(PyObject *self, PyObject *args)
+{
+    (void)self;
+    (void)args;
+
+    /* Disable all Python reimplementations of virtuals. */
+    sipInterpreter = NULL;
+
+    Py_INCREF(Py_None);
+    return Py_None;
+}
